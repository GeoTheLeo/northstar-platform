# Copy to .env.local and fill in your own key. Never commit .env.local.

# Required - the Anthropic API key used by lib/agent.ts.
ANTHROPIC_API_KEY=

# Optional - base URL of the FastAPI model-serving service (services/copilot_api).
# Defaults to http://127.0.0.1:8000 if unset.
COPILOT_API_URL=http://127.0.0.1:8000
